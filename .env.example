# --------------------------------------------------------------------------- #
# APPLICATION
# --------------------------------------------------------------------------- #
APP_NAME="real-estate-whatsapp-agent"
ENVIRONMENT=development
LOG_LEVEL=INFO
# Public HTTPS base URL of this service. Twilio signature validation hashes it,
# so it must match exactly what Twilio calls (no trailing slash).
PUBLIC_BASE_URL=https://your-domain.example.com

# --------------------------------------------------------------------------- #
# DATABASE
# --------------------------------------------------------------------------- #
# Local development (zero setup):
DATABASE_URL=sqlite:///./data/agent.db
# Production (docker-compose uses this automatically):
# DATABASE_URL=postgresql+psycopg2://agent:agent@localhost:5432/agent
DB_ECHO=false
AUTO_CREATE_TABLES=true

# Optional: enables multi-worker safe per-lead locks instead of in-process locks.
# REDIS_URL=redis://localhost:6379/0

# --------------------------------------------------------------------------- #
# TWILIO (WhatsApp)
# --------------------------------------------------------------------------- #
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
# Sandbox sender (join the sandbox first, see README):
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Production sender (a WhatsApp-enabled Twilio number):
# TWILIO_WHATSAPP_FROM=whatsapp:+14155550100

# Keep true in production. Disable only for local tunnels you fully trust.
VALIDATE_TWILIO_SIGNATURE=true

# twiml = reply inside the webhook response (recommended, fewer API calls)
# api   = send the reply with a second Twilio REST call
REPLY_MODE=twiml

# Master kill-switch. true = log messages only, never transmit.
# Flip to false only after a successful sandbox test.
DRY_RUN=true
OUTBOUND_RATE_LIMIT_PER_SECOND=1

# --------------------------------------------------------------------------- #
# HANDOFF / ADMIN
# --------------------------------------------------------------------------- #
# Qualified lead cards are pushed to this WhatsApp number.
ADMIN_WHATSAPP_NUMBER=01020645167
# Shared secret for the /api/* admin endpoints (send as X-API-Key).
# Leave empty ONLY for local development.
ADMIN_API_KEY=change-me-to-a-long-random-string
HANDOFF_NOTIFY_LEAD=true

# --------------------------------------------------------------------------- #
# LLM (optional)
# --------------------------------------------------------------------------- #
# false = fully deterministic agent (recommended to start).
LLM_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2

# --------------------------------------------------------------------------- #
# AGENT BEHAVIOUR
# --------------------------------------------------------------------------- #
DEFAULT_COUNTRY_CODE=1
QUESTION_ORDER=price,condition,size
MAX_QUESTIONS_PER_SLOT=3
