# --------------------------------------------------------------------------- #
# APPLICATION
# --------------------------------------------------------------------------- #
APP_NAME="real-estate-whatsapp-agent"
ENVIRONMENT=development
LOG_LEVEL=INFO
# Public HTTPS base URL of this service. Configure it in the Meta app dashboard
# as the webhook callback URL, e.g. https://your-domain.example.com/webhooks/whatsapp
PUBLIC_BASE_URL=https://your-domain.example.com

# --------------------------------------------------------------------------- #
# DATABASE
# --------------------------------------------------------------------------- #
# Local development (zero setup):
DATABASE_URL=sqlite:///./data/agent.db
# Production (docker-compose uses this automatically):
# DATABASE_URL=postgresql+psycopg2://agent:agent@localhost:5432/agent
DB_ECHO=false
AUTO_CREATE_TABLES=true

# Optional: enables multi-worker safe per-lead locks instead of in-process locks.
# REDIS_URL=redis://localhost:6379/0

# --------------------------------------------------------------------------- #
# META WHATSAPP CLOUD API
# --------------------------------------------------------------------------- #
# System user / temporary access token from the Meta app dashboard
# (WhatsApp > API Setup). In production use a System User token with
# whatsapp_business_messaging permission.
META_ACCESS_TOKEN=EAAGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# "Phone number ID" of your Cloud API sender (NOT the phone number itself).
META_PHONE_NUMBER_ID=123456789012345

# WhatsApp Business Account id — optional, used for logs/ops only.
META_WABA_ID=

# Webhook verification token you invent and paste into
# Meta App Dashboard > WhatsApp > Configuration > Verify token.
META_VERIFY_TOKEN=change-me-verify-token

# Meta App Secret (App Dashboard > Settings > Basic). Enables verification of
# the X-Hub-Signature-256 header on every webhook POST. Strongly recommended.
META_APP_SECRET=

# Graph API version and base URL.
META_API_VERSION=v18.0
META_GRAPH_BASE_URL=https://graph.facebook.com
META_REQUEST_TIMEOUT_SECONDS=15
META_MAX_RETRIES=2

# Approved template for the campaign opener. Business-initiated messages MUST
# use a template. Leave empty only for testing inside an open 24h window.
META_WELCOME_TEMPLATE_NAME=real_estate_opener
META_TEMPLATE_LANGUAGE=en_US
# Comma separated body variables of that template, e.g. "first_name,company".
# Supported tokens: first_name, full_name, agent, company, market.
META_TEMPLATE_PARAMS=first_name

# Keep true in production. Disabled automatically when META_APP_SECRET is empty.
VALIDATE_META_SIGNATURE=true

# Master kill-switch. true = log messages only, never transmit.
# Flip to false only after a successful end-to-end test.
DRY_RUN=true
OUTBOUND_RATE_LIMIT_PER_SECOND=1

# --------------------------------------------------------------------------- #
# HANDOFF / ADMIN
# --------------------------------------------------------------------------- #
# Qualified lead cards are pushed to this WhatsApp number.
ADMIN_WHATSAPP_NUMBER=01020645167
# Shared secret for the /api/* admin endpoints (send as X-API-Key).
# Leave empty ONLY for local development.
ADMIN_API_KEY=change-me-to-a-long-random-string
HANDOFF_NOTIFY_LEAD=true

# --------------------------------------------------------------------------- #
# LLM (optional)
# --------------------------------------------------------------------------- #
# false = fully deterministic agent (recommended to start).
LLM_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2

# --------------------------------------------------------------------------- #
# AGENT BEHAVIOUR
# --------------------------------------------------------------------------- #
DEFAULT_COUNTRY_CODE=1
QUESTION_ORDER=price,condition,size
MAX_QUESTIONS_PER_SLOT=3
